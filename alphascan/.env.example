# AlphaScan Environment Configuration
# Fill in your API keys below. Only configure the services you want to use.

# REQUIRED for Censys scanning (get PAT: https://console.censys.io/api)
CENSYS_PAT=your_personal_access_token

# REQUIRED for GitHub scanning (free: https://github.com/settings/tokens)
GITHUB_TOKEN=your_github_token

# REQUIRED for LLM-based key extraction (free: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key

# REQUIRED for Discord reporting (create webhook in Discord channel settings)
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# OPTIONAL for crypto wallet balance checks (free: https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=your_etherscan_api_key

# ── Scan Settings ─────────────────────────────────────────────────
SCAN_INTERVAL=300
MAX_KEYS_PER_REPORT=50